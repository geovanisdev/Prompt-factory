# --- dados (nunca commitar parquet / sqlite / npy / exports) ---
# Tudo dentro de data/ é ignorado, EXCETO os .gitkeep que preservam a estrutura.
data/**
!data/**/
!data/**/.gitkeep

# Artefatos gerados da campanha de rotulagem. VERSIONADOS: a taxonomia, os
# mapeamentos, o manifest.json (o livro-caixa, que é o estado da campanha) e
# labeling/labels/ — os rótulos são o único artefato NÃO regenerável da campanha
# (horas de trabalho de agente) e carregam só uid + 4 rótulos, zero texto do
# corpus, então podem viver no git sem preocupação de licença. Os lotes e a
# semente, ao contrário, CARREGAM o texto dos prompts: ficam fora do git
# (histórico não se apaga se o repo um dia ficar público) e o backup deles é
# cópia para outro disco (F:\backups\prompt-factory).
labeling/batches/**
!labeling/batches/**/
!labeling/batches/**/.gitkeep
labeling/seed/**
!labeling/seed/**/
!labeling/seed/**/.gitkeep

# Campanha de GERAÇÃO da Bancada (P4c). Mesma regra da rotulagem, e pela mesma
# razão: VERSIONADO é só o `manifest.json` (o livro-caixa, que É o estado da
# campanha e o que a torna retomável entre sessões). Os lotes carregam o texto
# dos prompts do corpus e as respostas carregam o material gerado — nem um nem
# outro entra no git.
geracao/lotes/**
!geracao/lotes/**/
!geracao/lotes/**/.gitkeep
geracao/respostas/**
!geracao/respostas/**/
!geracao/respostas/**/.gitkeep

# Campanha de DESTILAÇÃO (Central de Briefs Pedagógicos). Mesma forma das duas
# acima e a regra MAIS DURA das três: nas outras o texto é do corpus (licenciado,
# com atribuição por linha); aqui é material didático de TERCEIROS — três
# editoras comerciais, copyright integral, sem concessão de licença nenhuma, e
# ainda com citações de outros titulares dentro dele. Histórico de git não se
# apaga, então nem uma linha desse texto pode entrar. Versionado é só o
# `manifest.json` — o livro-caixa, que guarda estado e cursor, nunca conteúdo.
destilacao/lotes/**
!destilacao/lotes/**/
!destilacao/lotes/**/.gitkeep
destilacao/respostas/**
!destilacao/respostas/**/
!destilacao/respostas/**/.gitkeep

# cache de modelos/datasets do HuggingFace, caso alguém aponte HF_HOME pra cá
hf-cache/

# --- python / uv ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# NÃO ignorar uv.lock — ele É commitado (build reprodutível).

# --- diversos ---
*.bak
*.tmp
.DS_Store
Thumbs.db

# Dump do annotate.sqlite (scripts/backup_bancada.py). Já foi versionado e saiu
# do HEAD e da história na Camada 1: carrega texto derivado do corpus e os
# gabaritos escondidos das sintéticas. O padrão do script é data/backups/ (já
# coberto por data/); esta linha fecha a porta a quem apontar --destino para
# a pasta antiga.
backups/
