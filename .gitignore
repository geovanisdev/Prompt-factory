# --- dados (nunca commitar parquet / sqlite / npy / exports) ---
# Tudo dentro de data/ é ignorado, EXCETO os .gitkeep que preservam a estrutura.
data/**
!data/**/
!data/**/.gitkeep

# Artefatos gerados da campanha de rotulagem. VERSIONADOS: a taxonomia, os
# mapeamentos, o manifest.json (o livro-caixa, que é o estado da campanha) e
# labeling/labels/ — os rótulos são o único artefato NÃO regenerável da campanha
# (horas de trabalho de agente) e carregam só uid + 4 rótulos, zero texto do
# corpus, então podem viver no git sem preocupação de licença. Os lotes e a
# semente, ao contrário, CARREGAM o texto dos prompts: ficam fora do git
# (histórico não se apaga se o repo um dia ficar público) e o backup deles é
# cópia para outro disco (F:\backups\prompt-factory).
labeling/batches/**
!labeling/batches/**/
!labeling/batches/**/.gitkeep
labeling/seed/**
!labeling/seed/**/
!labeling/seed/**/.gitkeep

# Campanha de GERAÇÃO da Bancada (P4c). Mesma regra da rotulagem, e pela mesma
# razão: VERSIONADO é só o `manifest.json` (o livro-caixa, que É o estado da
# campanha e o que a torna retomável entre sessões). Os lotes carregam o texto
# dos prompts do corpus e as respostas carregam o material gerado — nem um nem
# outro entra no git.
geracao/lotes/**
!geracao/lotes/**/
!geracao/lotes/**/.gitkeep
geracao/respostas/**
!geracao/respostas/**/
!geracao/respostas/**/.gitkeep

# cache de modelos/datasets do HuggingFace, caso alguém aponte HF_HOME pra cá
hf-cache/

# --- python / uv ---
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# NÃO ignorar uv.lock — ele É commitado (build reprodutível).

# --- diversos ---
*.bak
*.tmp
.DS_Store
Thumbs.db
